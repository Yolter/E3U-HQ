# ---- backend/.env.example -------------------------------------------------
# Copy to backend/.env and fill in. Never commit the real .env.

# MongoDB (local dev or MongoDB Atlas SRV string)
MONGO_URL=mongodb://localhost:27017
DB_NAME=e3u_hq

# Comma-separated list of allowed browser origins (no trailing slash).
# Cloudflare Pages example: https://e3u-hq.pages.dev,https://hq.e3u.gg
CORS_ORIGINS=http://localhost:3000

# Public URL of the frontend — used in email links.
APP_URL=http://localhost:3000

# Session cookie: use "none" (with HTTPS) when the API is on a different domain
# than the frontend, otherwise "lax".
COOKIE_SAMESITE=lax

# ---- AI (pick ONE) --------------------------------------------------------
# On the Emergent platform:
EMERGENT_LLM_KEY=
# Anywhere else (portable): an OpenAI-compatible key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Email (pick ONE) -----------------------------------------------------
# On the Emergent platform:
EMERGENT_EMAIL_KEY=
# Anywhere else (portable): your own Resend key + a verified sender domain
RESEND_API_KEY=
EMAIL_FROM=E3U HQ <hq@yourdomain.com>
EMAIL_FROM_NAME=E3U HQ
# EMAIL_REPLY_TO=leader@yourdomain.com
